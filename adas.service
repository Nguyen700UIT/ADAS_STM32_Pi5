[Unit]
Description=ADAS Lane & Traffic Sign Recognition System
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=donien
Group=donien
WorkingDirectory=/home/donien/ADAS_STM32_Pi5
Environment="PYTHONPATH=/home/donien/ADAS_STM32_Pi5/lane_and_trafficsign/ADAS_STM32_Pi5"
Environment="PATH=/home/donien/ADAS_STM32_Pi5/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/donien/ADAS_STM32_Pi5/venv/bin/python /home/donien/ADAS_STM32_Pi5/lane_and_trafficsign/ADAS_STM32_Pi5/adas/app/main.py --camera --no-display
Restart=on-failure
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=adas

[Install]
WantedBy=multi-user.target
